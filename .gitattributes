* text=auto eol=lf

# Source and configuration
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Large research tables remain tracked but do not produce noisy text diffs.
data/**/*.csv -diff
outputs/**/*.csv -diff

# Binary artifacts
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.pkl binary
*.joblib binary
*.npy binary
*.npz binary

