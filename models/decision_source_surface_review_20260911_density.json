            "    .compact-dashboard .brand h1 { font-size: 1rem; }\n",
            "    .compact-dashboard .icon-btn { width: 34px; height: 34px; font-size: 18px; }\n",
            "    .compact-dashboard main { padding-top: 6px; }\n",
            "    .compact-dashboard .status-band { padding: 6px 8px; gap: 8px; }\n",
